{
  "schemaVersion": 1,
  "title": "Habit tracking",
  "description": "Monochrome, pill-shaped, and set in Comic Neue.",
  "elements": [
    {
      "$type": "label",
      "text": "This week",
      "headingLevel": 3,
      "wrapText": true,
      "isMuted": false,
      "key": "",
      "rules": []
    },
    {
      "$type": "progress",
      "value": 6,
      "minimum": 0,
      "maximum": 7,
      "isIndeterminate": false,
      "showPercentage": false,
      "segments": 7,
      "key": "",
      "rules": []
    },
    {
      "$type": "separator",
      "orientation": "horizontal",
      "key": "",
      "rules": []
    },
    {
      "$type": "textBox",
      "placeholder": "Drink water",
      "isMultiline": false,
      "lines": 4,
      "wrapText": true,
      "isReadOnly": false,
      "key": "habit",
      "label": "Habit",
      "rules": []
    },
    {
      "$type": "dropdown",
      "isEditable": false,
      "showSearch": false,
      "options": [
        {
          "value": "Every day",
          "display": "Every day",
          "isEnabled": true
        },
        {
          "value": "Weekdays",
          "display": "Weekdays",
          "isEnabled": true
        },
        {
          "value": "Weekends",
          "display": "Weekends",
          "isEnabled": true
        }
      ],
      "selectFirstByDefault": true,
      "isReadOnly": false,
      "key": "repeat",
      "label": "Repeat",
      "rules": []
    },
    {
      "$type": "slider",
      "minimum": 1,
      "maximum": 10,
      "step": 1,
      "decimalPlaces": 0,
      "showValue": true,
      "showTicks": false,
      "defaultValue": 7,
      "isReadOnly": false,
      "key": "target",
      "label": "Target",
      "rules": []
    },
    {
      "$type": "checkBox",
      "content": "Remind me",
      "isReadOnly": false,
      "key": "remind",
      "rules": []
    },
    {
      "$type": "toggle",
      "onText": "On",
      "offText": "Off",
      "defaultValue": true,
      "isReadOnly": false,
      "key": "active",
      "label": "Active",
      "rules": []
    },
    {
      "$type": "groupBox",
      "header": "Advanced",
      "children": [
        {
          "$type": "numeric",
          "increment": 1,
          "decimalPlaces": 2,
          "unit": "days",
          "showSpinner": true,
          "defaultValue": 30,
          "isReadOnly": false,
          "key": "streak",
          "label": "Streak goal",
          "rules": []
        },
        {
          "$type": "colorPicker",
          "showAlpha": false,
          "presets": [],
          "defaultValue": {
            "$color": "#16161A"
          },
          "isReadOnly": false,
          "key": "tint",
          "label": "Tint",
          "rules": []
        }
      ],
      "key": "",
      "rules": []
    }
  ],
  "buttons": {
    "submitText": "Submit",
    "cancelText": "Cancel",
    "showSubmit": true,
    "showCancel": true,
    "extraButtons": [],
    "closeOnEscape": true
  },
  "window": {
    "width": 480,
    "minWidth": 280,
    "minHeight": 120,
    "maxHeight": 800,
    "isResizable": true,
    "showInTaskbar": false,
    "topmost": false
  },
  "theme": {
    "mode": "light",
    "preset": "classic",
