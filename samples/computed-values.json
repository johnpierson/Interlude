{
  "schemaVersion": 1,
  "title": "Quantity takeoff",
  "description": "The totals are computed. Change a quantity and watch them settle in order.",
  "elements": [
    {
      "$type": "numeric",
      "minimum": 0,
      "increment": 1,
      "decimalPlaces": 2,
      "showSpinner": true,
      "defaultValue": 12.0,
      "isReadOnly": false,
      "key": "quantity",
      "label": "Quantity",
      "rules": []
    },
    {
      "$type": "numeric",
      "minimum": 0,
      "increment": 1,
      "decimalPlaces": 2,
      "unit": "£",
      "showSpinner": true,
      "defaultValue": 45.5,
      "isReadOnly": false,
      "key": "unitPrice",
      "label": "Unit price",
      "rules": []
    },
    {
      "$type": "numeric",
      "increment": 1,
      "decimalPlaces": 2,
      "unit": "£",
      "showSpinner": false,
      "computed": {
        "$type": "arithmetic",
        "operator": "multiply",
        "left": {
          "$type": "field",
          "key": "quantity"
        },
        "right": {
          "$type": "field",
          "key": "unitPrice"
        }
      },
      "isReadOnly": false,
      "key": "subtotal",
      "label": "Subtotal",
      "rules": []
    },
    {
      "$type": "slider",
      "minimum": 0,
      "maximum": 25,
      "step": 0.5,
      "decimalPlaces": 1,
      "showValue": true,
      "showTicks": false,
      "defaultValue": 20,
      "isReadOnly": false,
      "key": "vatRate",
      "label": "VAT",
      "rules": []
    },
    {
      "$type": "numeric",
      "increment": 1,
      "decimalPlaces": 2,
      "unit": "£",
      "showSpinner": false,
      "computed": {
        "$type": "arithmetic",
        "operator": "divide",
        "left": {
          "$type": "arithmetic",
          "operator": "multiply",
          "left": {
            "$type": "field",
            "key": "subtotal"
          },
          "right": {
            "$type": "field",
            "key": "vatRate"
          }
        },
        "right": {
          "$type": "constant",
          "value": 100.0
        }
      },
      "isReadOnly": false,
      "key": "vat",
      "label": "VAT amount",
      "rules": []
    },
    {
      "$type": "numeric",
      "increment": 1,
      "decimalPlaces": 2,
      "unit": "£",
      "showSpinner": false,
      "computed": {
        "$type": "arithmetic",
        "operator": "add",
        "left": {
          "$type": "field",
          "key": "subtotal"
        },
        "right": {
          "$type": "field",
          "key": "vat"
        }
      },
      "isReadOnly": false,
      "key": "total",
      "label": "Total",
      "rules": []
    },
    {
      "$type": "separator",
      "orientation": "horizontal",
      "key": "",
      "rules": []
    },
    {
      "$type": "textBox",
      "isMultiline": false,
      "lines": 4,
      "wrapText": true,
      "defaultValue": "Ada",
      "isReadOnly": false,
      "key": "orderedBy",
      "label": "Ordered by",
      "rules": []
    },
    {
      "$type": "textBox",
      "isMultiline": false,
      "lines": 4,
      "wrapText": true,
      "computed": {
        "$type": "format",
        "template": "{quantity} items for {orderedBy}, £{total} including VAT"
      },
      "isReadOnly": true,
      "key": "summary",
      "label": "Summary",
      "rules": []
    }
  ],
  "buttons": {
    "submitText": "Submit",
    "cancelText": "Cancel",
    "showSubmit": true,
    "showCancel": true,
    "extraButtons": [],
    "closeOnEscape": true
  },
  "window": {
    "width": 480,
    "minWidth": 280,
    "minHeight": 120,
    "maxHeight": 800,
    "isResizable": true,
    "showInTaskbar": false,
    "topmost": false
  },
  "theme": {
    "mode": "auto",
    "cornerRadius": 4,
    "fontSize": 13,
    "density": "comfortable",
    "reducedMotion": false,
    "labelWidth": 130,
    "baseSpacing": 8,
    "controlHeight": 28
  },
  "formId": "",
  "rememberValues": true,
  "headlessUseDefaults": false
}