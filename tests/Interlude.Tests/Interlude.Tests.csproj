<Project Sdk="Microsoft.NET.Sdk">

  <!--
    DEV ONLY. Never shipped, never copied into a Dynamo package.

    Targets the same framework as the Dynamo 4.0 flavour of Interlude, which is what a plain
    `dotnet build` produces. The 3.0 and 3.6 flavours compile from identical source against an
    older Dynamo reference assembly, so CI compiles all three and runs the tests once.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>

    <!-- xUnit's analyzers are helpful but not worth failing CI over. -->
    <NoWarn>$(NoWarn);CA1707</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Interlude\Interlude.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />

    <!-- STA smoke tests need a real single-threaded apartment; WPF controls refuse to exist otherwise. -->
    <PackageReference Include="Xunit.StaFact" Version="3.0.13" />

    <!--
      Referenced with full assets, unlike the shipped project. Interlude's public types carry
      [IsVisibleInDynamoLibrary] attributes, and the architecture and API-surface tests read
      them; reflecting over an attribute whose assembly is absent throws. Reading Dynamo
      metadata is safe. Executing Dynamo types is not, and no test does.
    -->
    <PackageReference Include="DynamoVisualProgramming.ZeroTouchLibrary" Version="4.0.2.3870" />
  </ItemGroup>

</Project>
