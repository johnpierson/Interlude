      {
        "Id": "be70915f56c9fcc24753cf316bc804e0",
        "Title": "Describe the field",
        "DescriptionText": "Anything that is not a number counts as zero, so a half-filled form shows a running total rather than an error, and a multi-select of numbers adds up its own items.",
        "IsExpanded": true,
        "WidthAdjustment": 0,
        "HeightAdjustment": 0,
        "UserSetWidth": 0,
