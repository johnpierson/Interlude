    "Annotations": [
      {
        "Id": "c3a8b2c6c8c5a82fd32a9f850682907e",
        "Title": "Describe the field",
        "DescriptionText": "What the form holds, built left to right: literals into a code block, the code block into a node, and the nodes gathered into the list Form.Show takes.",
        "IsExpanded": true,
        "WidthAdjustment": 0,
        "HeightAdjustment": 0,
        "UserSetWidth": 0,
        "UserSetHeight": 0,
        "Nodes": [
