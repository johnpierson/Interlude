      {
        "Id": "48e154cb5f0c4a789d185e53162a3fde",
        "Title": "Dress it",
        "DescriptionText": "Where the named themes stop. Everything has a default, so wiring one port changes one thing — this sets a compact density and rounder corners and leaves the rest alone. labelWidth is the one to reach for when a form's labels wrap.",
        "IsExpanded": true,
        "WidthAdjustment": 0,
        "HeightAdjustment": 0,
        "UserSetWidth": 0,
        "UserSetHeight": 0,
        "Nodes": [
          "a5737263b366bd383a93d39bc716d036",
