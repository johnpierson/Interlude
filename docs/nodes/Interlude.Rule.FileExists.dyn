      {
        "Id": "bb7783482fbd9cd5b2b0d13d7cf87f82",
        "Title": "Describe the field",
        "DescriptionText": "A path typed rather than browsed to, or one browsed to last week and moved since, both come back as text that looks fine. This is what checks the disk before the graph tries to open it.",
        "IsExpanded": true,
        "WidthAdjustment": 0,
        "HeightAdjustment": 0,
        "UserSetWidth": 0,
        "UserSetHeight": 0,
        "Nodes": [
