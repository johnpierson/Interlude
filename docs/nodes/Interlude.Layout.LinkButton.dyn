    "Annotations": [
      {
        "Id": "695ad46958d5fa7626edeeb318be459e",
        "Title": "Describe the field",
        "DescriptionText": "Opens a link and leaves the form alone. Useful for the standard, the wiki page or the ticket that explains why the form asks what it asks.",
        "IsExpanded": true,
        "WidthAdjustment": 0,
        "HeightAdjustment": 0,
        "UserSetWidth": 0,
        "UserSetHeight": 0,
        "Nodes": [
          "a48fe190a9509141254c62d1b0457e7e",
