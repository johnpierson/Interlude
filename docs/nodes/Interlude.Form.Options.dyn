      {
        "Id": "e145ee1d694ce33e7952b77fd07e9bd2",
        "Title": "Set the extras",
        "DescriptionText": "A description above the fields, a fixed height, whether the dialog resizes, and any extra buttons. They live here rather than on Form.Show because a node with twenty ports is harder to read than one with twelve and a bundle.",
        "IsExpanded": true,
        "WidthAdjustment": 0,
        "HeightAdjustment": 0,
        "UserSetWidth": 0,
        "UserSetHeight": 0,
        "Nodes": [
