      {
        "Id": "5bbc06771a4cb93a9b3507b1cc963670",
        "Title": "Describe the field",
        "DescriptionText": "Puts every field back to its default without closing the form. It does not submit, so nothing downstream runs.",
        "IsExpanded": true,
        "WidthAdjustment": 0,
        "HeightAdjustment": 0,
        "UserSetWidth": 0,
        "UserSetHeight": 0,
        "Nodes": [
