    "Annotations": [
      {
        "Id": "405f5653baff5a0ac84d58a5814a7ad4",
        "Title": "Describe the field",
        "DescriptionText": "A progress bar. It shows a value rather than tracking work: a form is answered and then closed, so this reports where a longer job has got to.",
        "IsExpanded": true,
        "WidthAdjustment": 0,
        "HeightAdjustment": 0,
        "UserSetWidth": 0,
        "UserSetHeight": 0,
        "Nodes": [
