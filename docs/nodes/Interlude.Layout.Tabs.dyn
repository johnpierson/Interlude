    "Annotations": [
      {
        "Id": "e2ff9a2665c9dc6b9f0d7c21f23bffd2",
        "Title": "Describe the field",
        "DescriptionText": "Pages behind a tab strip, each one a Layout.TabPage. Every page's fields are answered whether or not the user visited it, so a required field on a tab nobody opened still stops the form.",
        "IsExpanded": true,
        "WidthAdjustment": 0,
        "HeightAdjustment": 0,
        "UserSetWidth": 0,
