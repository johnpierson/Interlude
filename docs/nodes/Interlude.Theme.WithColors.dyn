      {
        "Id": "7297ded8bbb0c0493c57cbf190adaace",
        "Title": "Dress it",
        "DescriptionText": "Takes a theme and changes its colours, leaving its shape, spacing and type alone — so a practice palette can be dropped onto any of the named themes without rebuilding it. Every colour is optional: the ones left blank keep what the theme had.",
        "IsExpanded": true,
        "WidthAdjustment": 0,
        "HeightAdjustment": 0,
        "UserSetWidth": 0,
        "UserSetHeight": 0,
        "Nodes": [
          "65bb159060ef3387513f44f740be7ea0",
          "6403bb64f63a615f64bdc67303b0a604",
