    "Annotations": [
      {
        "Id": "29fdfa33a1c7a01cef4f589769608ea2",
        "Title": "Describe the field",
        "DescriptionText": "A rule is an ingredient: Behavior.WithValidation is what applies it to a field. minimum and maximum each take null to mean unbounded, so this is also how to write \"at least six characters\" on its own.",
        "IsExpanded": true,
        "WidthAdjustment": 0,
        "HeightAdjustment": 0,
        "UserSetWidth": 0,
        "UserSetHeight": 0,
        "Nodes": [
