      },
      {
        "Id": "895e302deea22b6ac3da587bce8dd256",
        "Title": "Read the answer",
        "DescriptionText": "In the same order as Result.Keys, so the two zip together into a dictionary. On its own it is what feeds a node that wants the answers as a list and does not care what they were called.",
        "IsExpanded": true,
        "WidthAdjustment": 0,
        "HeightAdjustment": 0,
        "UserSetWidth": 0,
        "UserSetHeight": 0,
        "Nodes": [
