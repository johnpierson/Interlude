    "Annotations": [
      {
        "Id": "91bcaa501e3026fb3f298a6b595f5a8c",
        "Title": "Describe the field",
        "DescriptionText": "What the form holds, built left to right: literals into a code block, the code block into a node, and the nodes gathered into the list Form.Show takes.",
        "IsExpanded": true,
        "WidthAdjustment": 0,
        "HeightAdjustment": 0,
        "UserSetWidth": 0,
        "UserSetHeight": 0,
        "Nodes": [
          "2dc4824ff4263f98f4047cb7bf85b63a",
          "90e02137ac48c3d2d06f4f0993b65bc8",
          "a98aaf8e086f15edb6ab21df145ed128",
          "b12b26a7da8dc4348eee6f5bf9f58b76",
