      {
        "Id": "7eb6e3ce7031a785f6eac3b7514d9700",
        "Title": "Describe the field",
        "DescriptionText": "Extensions are the usual reason to ask. ignoreCase matters more here than elsewhere, because a file picked off disk arrives with whatever case it was saved with.",
        "IsExpanded": true,
        "WidthAdjustment": 0,
        "HeightAdjustment": 0,
        "UserSetWidth": 0,
