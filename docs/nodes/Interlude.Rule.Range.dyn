    "Annotations": [
      {
        "Id": "f241f4708f7fa70d0570a29d1384fae2",
        "Title": "Describe the field",
        "DescriptionText": "Either bound takes null to mean unbounded, so this is also how to write \"at least 2.4\" on its own. The bounds on Input.Number stop the spinner; these stop the form, which is what catches a number that was typed rather than stepped.",
        "IsExpanded": true,
        "WidthAdjustment": 0,
        "HeightAdjustment": 0,
        "UserSetWidth": 0,
        "UserSetHeight": 0,
        "Nodes": [
