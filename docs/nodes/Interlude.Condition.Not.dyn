    "Annotations": [
      {
        "Id": "ec78b379f4689b3009787ea97e7c42fc",
        "Title": "Describe the field",
        "DescriptionText": "Useful over a condition that has no opposite of its own — an And, an Or, a Matches. Where there is a named opposite, Condition.IsNotChecked here, prefer it: it says the same thing without the reader having to invert it.",
        "IsExpanded": true,
        "WidthAdjustment": 0,
        "HeightAdjustment": 0,
        "UserSetWidth": 0,
        "UserSetHeight": 0,
        "Nodes": [
