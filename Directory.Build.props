<Project>

  <!--
    Repository-wide defaults. Deliberately minimal: the shipped assembly
    (src/Interlude/Interlude.csproj) owns everything that affects what lands
    in a user's Dynamo package folder.
  -->

  <PropertyGroup>
    <LangVersion>12.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <Deterministic>true</Deterministic>
    <NeutralLanguage>en-US</NeutralLanguage>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <AccelerateBuildsInVisualStudio>true</AccelerateBuildsInVisualStudio>
  </PropertyGroup>

  <!-- Product identity. AssemblyVersion is FROZEN; only FileVersion floats. -->
  <PropertyGroup>
    <Product>Interlude</Product>
    <Authors>John Pierson</Authors>
    <Company>John Pierson</Company>
    <Copyright>Copyright (c) 2026 John Pierson</Copyright>
    <PackageLicenseExpression>BSD-3-Clause</PackageLicenseExpression>
    <VersionPrefix Condition="'$(VersionPrefix)' == ''">1.0.4</VersionPrefix>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>$(VersionPrefix).0</FileVersion>
    <InformationalVersion>$(VersionPrefix)</InformationalVersion>
    <RepositoryUrl>https://github.com/johnpierson/Interlude</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <!--
    Warnings are errors in CI only, so the local inner loop stays fast and
    forgiving while `main` stays clean.
  -->
  <PropertyGroup Condition="'$(ContinuousIntegrationBuild)' == 'true'">
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

</Project>
