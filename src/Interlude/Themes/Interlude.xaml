<!--
    The theme entry point. WpfThemeApplier merges this into the FORM WINDOW's resource
    dictionary, never into Application.Current.Resources, so nothing here can reach Revit's or
    Dynamo's own UI.

    Every colour, size and radius below is a DynamicResource lookup of a key the applier writes
    at run time (see Interlude.Theming.ThemeKeys). Nothing is hard-coded, which is what makes a
    light/dark switch a dictionary update rather than a rebuild, and what lets an author restyle
    a form by supplying a palette instead of a stylesheet.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="pack://application:,,,/Interlude;component/Themes/Inputs.xaml" />
    <ResourceDictionary Source="pack://application:,,,/Interlude;component/Themes/Buttons.xaml" />
    <ResourceDictionary Source="pack://application:,,,/Interlude;component/Themes/Containers.xaml" />
  </ResourceDictionary.MergedDictionaries>

  <!-- Text that is not part of a control still needs the theme's colour and metrics. -->
  <Style TargetType="{x:Type TextBlock}">
    <Setter Property="Foreground" Value="{DynamicResource Interlude.Foreground}" />
    <Setter Property="FontSize" Value="{DynamicResource Interlude.FontSize}" />
    <Setter Property="FontFamily" Value="{DynamicResource Interlude.FontFamily}" />
    <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
  </Style>

  <Style TargetType="{x:Type ToolTip}">
    <Setter Property="Background" Value="{DynamicResource Interlude.SurfaceAlt}" />
    <Setter Property="Foreground" Value="{DynamicResource Interlude.Foreground}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Interlude.Border}" />
    <Setter Property="BorderThickness" Value="{DynamicResource Interlude.BorderThickness}" />
    <Setter Property="Padding" Value="8,4" />
    <Setter Property="FontSize" Value="{DynamicResource Interlude.FontSizeSmall}" />
    <Setter Property="FontFamily" Value="{DynamicResource Interlude.FontFamily}" />
    <Setter Property="MaxWidth" Value="360" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ToolTip}">
          <Border Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="{DynamicResource Interlude.CornerRadius}"
                  Padding="{TemplateBinding Padding}">
            <ContentPresenter />
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

</ResourceDictionary>
