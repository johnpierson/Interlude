<!--
    Buttons, tick boxes, radio buttons and the toggle switch.

    The switch is drawn here rather than shipped as a control: WPF has no switch, and a template
    over a ToggleButton costs a few lines and no dependency.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:interlude="clr-namespace:Interlude.Rendering.Wpf">

  <Style TargetType="{x:Type Button}">
    <Setter Property="Foreground" Value="{DynamicResource Interlude.Foreground}" />
    <Setter Property="Background" Value="{DynamicResource Interlude.ControlBackground}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Interlude.Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="12,4" />
    <Setter Property="MinHeight" Value="{DynamicResource Interlude.ControlHeight}" />
    <Setter Property="FontSize" Value="{DynamicResource Interlude.FontSize}" />
    <Setter Property="FontFamily" Value="{DynamicResource Interlude.FontFamily}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type Button}">
          <Border x:Name="Surface"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="{DynamicResource Interlude.CornerRadius}"
                  Padding="{TemplateBinding Padding}"
                  SnapsToDevicePixels="True">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Surface" Property="Background"
                      Value="{DynamicResource Interlude.ControlBackgroundHover}" />
              <Setter TargetName="Surface" Property="BorderBrush"
                      Value="{DynamicResource Interlude.BorderStrong}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Surface" Property="BorderBrush"
                      Value="{DynamicResource Interlude.Accent}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Surface" Property="Background"
                      Value="{DynamicResource Interlude.SurfaceAlt}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Surface" Property="Background"
                      Value="{DynamicResource Interlude.ControlBackgroundDisabled}" />
              <Setter Property="Foreground" Value="{DynamicResource Interlude.ForegroundDisabled}" />
              <Setter Property="Cursor" Value="Arrow" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="Interlude.PrimaryButton" TargetType="{x:Type Button}"
         BasedOn="{StaticResource {x:Type Button}}">
    <Setter Property="Background" Value="{DynamicResource Interlude.Accent}" />
    <Setter Property="Foreground" Value="{DynamicResource Interlude.AccentForeground}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Interlude.Accent}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type Button}">
          <Border x:Name="Surface"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="{DynamicResource Interlude.CornerRadius}"
                  Padding="{TemplateBinding Padding}"
                  SnapsToDevicePixels="True">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Surface" Property="Background"
                      Value="{DynamicResource Interlude.AccentHover}" />
              <Setter TargetName="Surface" Property="BorderBrush"
                      Value="{DynamicResource Interlude.AccentHover}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Surface" Property="Background"
                      Value="{DynamicResource Interlude.ControlBackgroundDisabled}" />
              <Setter TargetName="Surface" Property="BorderBrush"
                      Value="{DynamicResource Interlude.Border}" />
              <Setter Property="Foreground" Value="{DynamicResource Interlude.ForegroundDisabled}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="Interlude.LinkButton" TargetType="{x:Type Button}">
    <Setter Property="Foreground" Value="{DynamicResource Interlude.Accent}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FontSize" Value="{DynamicResource Interlude.FontSizeSmall}" />
    <Setter Property="FontFamily" Value="{DynamicResource Interlude.FontFamily}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type Button}">
          <TextBlock x:Name="Text"
                     Text="{TemplateBinding Content}"
                     Foreground="{TemplateBinding Foreground}"
                     FontSize="{TemplateBinding FontSize}" />
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Text" Property="TextDecorations" Value="Underline" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Text" Property="Foreground"
                      Value="{DynamicResource Interlude.ForegroundDisabled}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="Interlude.SpinnerButton" TargetType="{x:Type RepeatButton}">
    <Setter Property="Width" Value="18" />
    <Setter Property="Height" Value="11" />
    <Setter Property="Foreground" Value="{DynamicResource Interlude.ForegroundMuted}" />
    <Setter Property="FontSize" Value="7" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type RepeatButton}">
          <Border x:Name="Surface" Background="Transparent" CornerRadius="2">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Surface" Property="Background"
                      Value="{DynamicResource Interlude.ControlBackgroundHover}" />
              <Setter Property="Foreground" Value="{DynamicResource Interlude.Foreground}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="{x:Type CheckBox}">
    <Setter Property="Foreground" Value="{DynamicResource Interlude.Foreground}" />
    <Setter Property="FontSize" Value="{DynamicResource Interlude.FontSize}" />
    <Setter Property="FontFamily" Value="{DynamicResource Interlude.FontFamily}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type CheckBox}">
          <StackPanel Orientation="Horizontal" Background="Transparent">
            <Border x:Name="Box"
                    Width="16" Height="16"
                    CornerRadius="3"
                    BorderThickness="1"
                    Background="{DynamicResource Interlude.ControlBackground}"
                    BorderBrush="{DynamicResource Interlude.BorderStrong}"
                    VerticalAlignment="Center"
                    SnapsToDevicePixels="True">
              <Path x:Name="Tick"
                    Data="M 2 6 L 5.5 9.5 L 11 3"
                    Stroke="{DynamicResource Interlude.AccentForeground}"
                    StrokeThickness="1.8"
                    StrokeEndLineCap="Round"
                    StrokeStartLineCap="Round"
                    Visibility="Collapsed" />
            </Border>
            <ContentPresenter x:Name="Label"
                              Margin="8,0,0,0"
                              VerticalAlignment="Center"
                              RecognizesAccessKey="True" />
          </StackPanel>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Box" Property="Background" Value="{DynamicResource Interlude.Accent}" />
              <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Interlude.Accent}" />
              <Setter TargetName="Tick" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Interlude.Accent}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Interlude.Accent}" />
            </Trigger>
            <Trigger Property="interlude:FieldState.HasError" Value="True">
              <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Interlude.Error}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Box" Property="Background"
                      Value="{DynamicResource Interlude.ControlBackgroundDisabled}" />
              <Setter Property="Foreground" Value="{DynamicResource Interlude.ForegroundDisabled}" />
              <Setter Property="Cursor" Value="Arrow" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="{x:Type RadioButton}">
    <Setter Property="Foreground" Value="{DynamicResource Interlude.Foreground}" />
    <Setter Property="FontSize" Value="{DynamicResource Interlude.FontSize}" />
    <Setter Property="FontFamily" Value="{DynamicResource Interlude.FontFamily}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type RadioButton}">
          <StackPanel Orientation="Horizontal" Background="Transparent">
            <Grid Width="16" Height="16" VerticalAlignment="Center">
              <Ellipse x:Name="Ring"
                       Stroke="{DynamicResource Interlude.BorderStrong}"
                       StrokeThickness="1"
                       Fill="{DynamicResource Interlude.ControlBackground}" />
              <Ellipse x:Name="Dot"
                       Width="8" Height="8"
                       Fill="{DynamicResource Interlude.Accent}"
                       Visibility="Collapsed" />
            </Grid>
            <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True" />
          </StackPanel>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Dot" Property="Visibility" Value="Visible" />
              <Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource Interlude.Accent}" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource Interlude.Accent}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Ring" Property="Fill"
                      Value="{DynamicResource Interlude.ControlBackgroundDisabled}" />
              <Setter Property="Foreground" Value="{DynamicResource Interlude.ForegroundDisabled}" />
              <Setter Property="Cursor" Value="Arrow" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="Interlude.ToggleSwitch" TargetType="{x:Type ToggleButton}">
    <Setter Property="Width" Value="38" />
    <Setter Property="Height" Value="20" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ToggleButton}">
          <Border x:Name="Track"
                  CornerRadius="10"
                  Background="{DynamicResource Interlude.SurfaceAlt}"
                  BorderBrush="{DynamicResource Interlude.BorderStrong}"
                  BorderThickness="1"
                  SnapsToDevicePixels="True">
            <Ellipse x:Name="Knob"
                     Width="14" Height="14"
                     Fill="{DynamicResource Interlude.ForegroundMuted}"
                     HorizontalAlignment="Left"
                     Margin="2,0,0,0" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Track" Property="Background" Value="{DynamicResource Interlude.Accent}" />
              <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource Interlude.Accent}" />
              <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
              <Setter TargetName="Knob" Property="Margin" Value="0,0,2,0" />
              <Setter TargetName="Knob" Property="Fill" Value="{DynamicResource Interlude.AccentForeground}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Track" Property="Background"
                      Value="{DynamicResource Interlude.ControlBackgroundDisabled}" />
              <Setter TargetName="Knob" Property="Fill"
                      Value="{DynamicResource Interlude.ForegroundDisabled}" />
              <Setter Property="Cursor" Value="Arrow" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="Interlude.SwatchButton" TargetType="{x:Type ToggleButton}">
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="MinHeight" Value="{DynamicResource Interlude.ControlHeight}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ToggleButton}">
          <Border x:Name="Surface"
                  Background="{DynamicResource Interlude.ControlBackground}"
                  BorderBrush="{DynamicResource Interlude.Border}"
                  BorderThickness="1"
                  CornerRadius="{DynamicResource Interlude.CornerRadius}"
                  Padding="{TemplateBinding Padding}">
            <ContentPresenter />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Surface" Property="BorderBrush"
                      Value="{DynamicResource Interlude.BorderStrong}" />
            </Trigger>
            <Trigger Property="interlude:FieldState.HasError" Value="True">
              <Setter TargetName="Surface" Property="BorderBrush"
                      Value="{DynamicResource Interlude.Error}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="Interlude.PresetSwatch" TargetType="{x:Type Button}">
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type Button}">
          <Border x:Name="Surface"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{DynamicResource Interlude.Border}"
                  BorderThickness="1"
                  CornerRadius="3" />
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Surface" Property="BorderBrush"
                      Value="{DynamicResource Interlude.Accent}" />
              <Setter TargetName="Surface" Property="BorderThickness" Value="2" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

</ResourceDictionary>
