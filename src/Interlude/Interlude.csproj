<Project Sdk="Microsoft.NET.Sdk">

  <!--
    THE ONLY SHIPPED ASSEMBLY THAT CONTAINS CODE.

    One Interlude.dll is built per Dynamo version. Pass -p:DynamoVersion=3.0|3.6|4.0
    (scripts/build-all.ps1 drives the matrix from versions.json). Layering between
    Model / Conditions / Validation / Runtime / Rendering / Serialization and the WPF
    code is enforced by namespaces plus ArchitectureTests, not by extra assemblies:
    every additional assembly would multiply across 3 Dynamo builds x N package folders.

    A package folder holds one other file ending in .dll: Interlude.customization.dll,
    which is how Dynamo insists node icons be delivered and which contains no types and
    no references at all. See src/Interlude.Icons and docs/architecture.md for why that
    was worth relaxing the rule for. The check below is unchanged and still exact: the
    icon assembly is a separate project with its own output, so nothing but Interlude.dll
    may appear here.
  -->

  <!-- DynamoVersion and the per-version output paths are set in Directory.Build.props,
       which MSBuild imports early enough to place obj/ without warning. -->

  <PropertyGroup Condition="'$(DynamoVersion)' == '3.0'">
    <TargetFramework>net8.0-windows</TargetFramework>
    <DynamoPackageVersion>3.0.3.7597</DynamoPackageVersion>
  </PropertyGroup>
  <PropertyGroup Condition="'$(DynamoVersion)' == '3.6'">
    <TargetFramework>net8.0-windows</TargetFramework>
    <DynamoPackageVersion>3.6.1.9900</DynamoPackageVersion>
  </PropertyGroup>
  <PropertyGroup Condition="'$(DynamoVersion)' == '4.0'">
    <TargetFramework>net10.0-windows</TargetFramework>
    <DynamoPackageVersion>4.0.2.3870</DynamoPackageVersion>
  </PropertyGroup>

  <Target Name="ValidateDynamoVersion" BeforeTargets="PrepareForBuild"
          Condition="'$(TargetFramework)' == ''">
    <Error Text="Unknown DynamoVersion '$(DynamoVersion)'. Supported values are 3.0, 3.6 and 4.0 (see versions.json)." />
  </Target>

  <PropertyGroup>
    <AssemblyName>Interlude</AssemblyName>
    <RootNamespace>Interlude</RootNamespace>
    <UseWPF>true</UseWPF>

    <!-- Dynamo reads Interlude.xml for port names and tooltips: it ships alongside the DLL. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Model/runtime types are public because they cross node ports; not every one needs prose. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>

    <EnableDefaultNoneItems>false</EnableDefaultNoneItems>
    <IncludeSymbols>false</IncludeSymbols>
    <DebugType Condition="'$(Configuration)' == 'Release'">none</DebugType>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <!--
    ZERO RUNTIME DEPENDENCIES.

    ExcludeAssets="runtime" means the Dynamo assemblies are used for attributes at
    compile time only and are never copied next to Interlude.dll. Dynamo supplies its
    own at load time; shipping ours would be an assembly-conflict generator. Everything
    else comes from the BCL and in-box WPF: no Newtonsoft (Dynamo pins its own), no
    System.Text.Json package reference (it is in-box on net8.0+).
  -->
  <ItemGroup>
    <PackageReference Include="DynamoVisualProgramming.ZeroTouchLibrary" Version="$(DynamoPackageVersion)"
                      ExcludeAssets="runtime" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Interlude_DynamoCustomization.xml" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!--
    Space Grotesk, embedded rather than referenced.

    <Resource> puts the font inside Interlude.dll rather than beside it, so the package does not
    grow a file to carry it. Referencing the font by name instead would mean it renders
    correctly only on machines where somebody had installed it, which for a package distributed to
    other people's Revit installs means "almost nowhere".

    These are the STATIC instances, not the variable font Google Fonts distributes. WPF's text
    stack has no support for variable font axes: it renders the default instance and nothing else,
    so a variable file would give us one weight and a synthetic, smeared bold for everything the
    theme sets in heavy type. Four real faces cost about 460 KB and look right.

    SIL Open Font License 1.1, no reserved font name. The licence travels with the binary: it is
    in Fonts/SpaceGrotesk-OFL.txt here, and pack.ps1 copies it into every package's extra/ folder.
    See THIRD-PARTY-NOTICES.md.
  -->
  <ItemGroup>
    <Resource Include="Fonts\SpaceGrotesk-Regular.ttf" />
    <Resource Include="Fonts\SpaceGrotesk-Medium.ttf" />
    <Resource Include="Fonts\SpaceGrotesk-Bold.ttf" />
    <Resource Include="Fonts\SpaceGrotesk-Light.ttf" />
    <None Include="Fonts\SpaceGrotesk-OFL.txt" />
  </ItemGroup>

  <!--
    The XAML compiler always emits a PUBLIC XamlGeneratedNamespace.GeneratedInternalTypeHelper,
    and Dynamo turns every public type into a library category, so leaving it in would put a
    meaningless "XamlGeneratedNamespace" entry in front of every user. It exists solely to let
    BAML instantiate INTERNAL types referenced from XAML; Themes/*.xaml references only public
    ones, which ArchitectureTests and the STA smoke tests both check. The MSBuild property that
    is supposed to suppress it is not honoured by the .NET SDK, so it is dropped here instead.
  -->
  <Target Name="DropGeneratedInternalTypeHelper" AfterTargets="MarkupCompilePass2" BeforeTargets="CoreCompile">
    <ItemGroup>
      <Compile Remove="@(Compile)" Condition="'%(Filename)%(Extension)' == 'GeneratedInternalTypeHelper.g.cs'" />
    </ItemGroup>
  </Target>

  <!--
    Guard rail for the single most damaging regression this project can have:
    a transitive package sneaking another DLL into the package's bin folder.
  -->

  <Target Name="VerifyNoExtraAssemblies" AfterTargets="Build" Condition="'$(DisableOutputVerification)' != 'true'">
    <ItemGroup>
      <_UnexpectedOutput Include="$(OutputPath)*.dll" Exclude="$(OutputPath)Interlude.dll" />
    </ItemGroup>
    <Error Condition="'@(_UnexpectedOutput)' != ''"
           Text="Interlude must ship exactly one code assembly, but the build output also contains: @(_UnexpectedOutput->'%(Filename)%(Extension)', ', '). Add ExcludeAssets=&quot;runtime&quot; to the offending PackageReference or remove it." />
  </Target>

</Project>
