<Project Sdk="Microsoft.NET.Sdk">

  <!--
    THE SECOND SHIPPED ASSEMBLY, AND THE ONLY ONE THAT IS NOT CODE.

    Dynamo will not read node icons out of the node library itself. It looks for a sibling file
    named <AssemblyName>.customization.dll and pulls the images out of a resource stream inside it.
    There is no other supported route, so an icon set costs exactly one extra file and the project's
    one-assembly rule had to become a rule about *code* assemblies. See docs/architecture.md.

    What makes that affordable is that this produces no types and references nothing. It is a
    container for 224 PNGs: there is nothing here to bind against, nothing to collide with another
    package's copy of the same library, and nothing that can execute. That is the entire reason the
    rule was worth relaxing for this and would not be worth relaxing for a dependency.
    VerifyResourceOnly below is what keeps that true.

    Both Images/ and InterludeImages.resources are generated by the preview harness's icons switch
    and checked in; see tools/Interlude.Preview/Icons.cs and scripts/build-all.ps1.
  -->

  <PropertyGroup>
    <!-- Interlude.dll -> Interlude.customization.dll, beside it in the package's bin folder. -->
    <AssemblyName>Interlude.customization</AssemblyName>

    <!--
      Built once for all three Dynamo versions. A resource assembly has no framework surface to be
      wrong about, so the per-version matrix that Interlude.dll needs would produce three identical
      files here.
    -->
    <TargetFramework>netstandard2.0</TargetFramework>

    <RootNamespace />

    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <IncludeSymbols>false</IncludeSymbols>
    <DebugType>none</DebugType>
    <EnableDefaultEmbeddedResourceItems>false</EnableDefaultEmbeddedResourceItems>

    <!-- Nothing here is localisable: the resources are pictures. -->
    <NeutralResourcesLanguage />
  </PropertyGroup>

  <ItemGroup>
    <!--
      A prebuilt .resources container, embedded verbatim rather than compiled from a .resx.

      LogicalName fixes the stream name. Dynamo derives the name it looks for from the node
      library's own name, so Interlude.dll means it asks for InterludeImages, and the lookup has no
      fallback: the wrong name gives no icons and no error to explain why.

      Verbatim because MSBuild cannot produce the format Dynamo reads. Compiling a .resx holding
      images requires GenerateResourceUsePreserializedResources, which writes a header naming
      System.Resources.Extensions.DeserializingResourceReader; the plain ResourceReader that
      Dynamo's own customization assemblies are written for throws on that header rather than
      ignoring it. So the container is written by the icon generator, which uses ResourceWriter
      directly and produces the classic format. See tools/Interlude.Preview/Icons.cs.
    -->
    <EmbeddedResource Include="InterludeImages.resources" LogicalName="InterludeImages.resources" />
  </ItemGroup>

  <!--
    The claim in the comment at the top has to stay true, so it is checked rather than asserted.
    A reference appearing here would mean this file had stopped being inert, which is the moment
    the trade that justified a second assembly stops holding.
  -->
  <Target Name="VerifyResourceOnly" AfterTargets="Build">
    <ItemGroup>
      <!-- Anything hand-written. The SDK's generated AssemblyInfo.cs lives under obj/ and declares
           attributes rather than types, so it is not what this is looking for. -->
      <_IconAssemblyCode Include="@(Compile)" Exclude="$(BaseIntermediateOutputPath)**\*.cs;obj\**\*.cs" />

      <!-- NETStandard.Library is the implicit reference-assembly pack: compile-time only, and it is
           what makes netstandard2.0 mean anything. Any other package would be a real dependency. -->
      <_IconAssemblyPackage Include="@(PackageReference)" Exclude="NETStandard.Library" />
    </ItemGroup>
    <Error Condition="'@(_IconAssemblyCode)' != ''"
           Text="Interlude.customization must contain no code, but it compiles: @(_IconAssemblyCode->'%(Filename)%(Extension)', ', '). It exists to hold PNGs; anything executable belongs in Interlude.dll." />
    <Error Condition="'@(_IconAssemblyPackage)' != ''"
           Text="Interlude.customization must have no package references, but it has: @(_IconAssemblyPackage->'%(Identity)', ', '). A resource assembly that drags in a dependency is exactly the second DLL the one-assembly rule exists to prevent." />
  </Target>

</Project>
